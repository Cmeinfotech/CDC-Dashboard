{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && node --test --test-isolation=none tests/rendered-html.test.mjs tests/amazon-monitor.test.mjs tests/amazon-tracking-changes.test.mjs tests/admin-reverse.test.mjs tests/security.test.mjs tests/amazon-search.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "admin:setup": "node scripts/configure-main-admin.mjs",
    "amazon:sync": "node scripts/amazon-daily-sync.mjs --now",
    "amazon:auto-sync": "node scripts/amazon-daily-sync.mjs",
    "amazon:auto-sync:configure": "node scripts/amazon-daily-sync.mjs --configure",
    "amazon:backfill": "node scripts/amazon-two-year-backfill.mjs",
    "amazon:reset-pull-data": "node scripts/reset-amazon-pull-storage.mjs",
    "amazon:sync-database": "node scripts/sync-amazon-pull-to-database.mjs",
    "test:amazon": "node --test --test-isolation=none tests/amazon-monitor.test.mjs",
    "test:security": "node --test --test-isolation=none tests/security.test.mjs tests/amazon-monitor.test.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "fflate": "^0.8.3",
    "lucide-react": "^1.31.0",
    "mysql2": "^3.23.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.36",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.3.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.1.0",
    "vite": "8.3.4",
    "wrangler": "4.149.0"
  },
  "type": "module",
  "overrides": {
    "fflate": "^0.8.3",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  }
}
